# VibePress settings. The installer creates the real file (.env) for you.
SESSION_SECRET=
PORT=3100
NODE_ENV=production
ADMIN_PATH=/admin
SITE_URL=https://example.com
SITE_NAME=VibePress
SITE_DIR=/var/www/vibepress/site
UPLOAD_DIR=/var/www/vibepress/site/uploads
DOWNLOAD_DIR=/var/www/vibepress/site/downloads
BACKUP_DIR=/var/www/vibepress/backups
BRAND_FILE=/var/www/vibepress/brand.json
NGINX_ACCESS_LOG=/var/log/nginx/access.log
MAX_APP_MB=600
# Optional
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
GEOIP_DB=
